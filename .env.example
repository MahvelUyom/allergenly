# ------------------------------------------------------------------
# Allergenly environment variables
# Copy this file to .env, then .env.local for secrets you don't want
# committed. See README.md for the full setup walkthrough.
# ------------------------------------------------------------------

# --- Database (PostgreSQL via Prisma) ---------------------------------
# Local dev default matches docker-compose.yml (`npm run db:up`).
DATABASE_URL="postgresql://allergenly:allergenly@localhost:5432/allergenly?schema=public"

# --- NextAuth (Auth.js) -------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth provider — create credentials at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- File storage (S3-compatible) --------------------------------------
# STORAGE_DRIVER=local uses ./storage on disk and needs no credentials —
# this is the default so the app runs out of the box. Switch to "s3" and
# fill in the values below (works with AWS S3, Cloudflare R2, Backblaze
# B2, DigitalOcean Spaces, MinIO, etc.) when you're ready.
STORAGE_DRIVER="local"
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_BASE_URL=""

# --- OCR / menu scanning -------------------------------------------------
# OCR_DRIVER=stub returns deterministic fake text so upload → allergen
# detection is exercisable without a real API key. Three real options:
#
#   "vision" — Google Cloud Vision, raw OCR only (text out, no allergen
#     reasoning — still goes through the keyword scanner in
#     lib/allergens.ts). Free tier: 1,000 units/month, then ~$1.50/1,000.
#     https://console.cloud.google.com/apis/library/vision.googleapis.com
#
#   "claude" — Claude reads the menu image/PDF directly and returns
#     structured items WITH a contextual allergen assessment in one call
#     (see lib/menu-scan-claude.ts) — no separate keyword-matching step.
#     Needs ANTHROPIC_API_KEY. Get one at https://console.anthropic.com
OCR_DRIVER="stub"
GOOGLE_CLOUD_VISION_CREDENTIALS_JSON=""
GOOGLE_CLOUD_VISION_KEYFILE=""
ANTHROPIC_API_KEY=""
# Optional — defaults to claude-opus-5 if unset. Cheaper options:
# claude-sonnet-5 or claude-haiku-4-5 (see README/chat history for the
# cost/quality tradeoff).
ANTHROPIC_MODEL=""
#
#   "gemini" — same idea as "claude" (structured items + contextual
#     allergen assessment in one call), via Gemini instead. Needs
#     GEMINI_API_KEY. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional — defaults to gemini-flash-latest if unset. Higher quality:
# gemini-pro-latest.
GEMINI_MODEL=""

# --- Email (password reset / verification) -------------------------------
# EMAIL_DRIVER=console just logs emails to the server console — fine for
# dev. Switch to "smtp" and fill in the block below for real delivery.
# Outlook/Office365 example: SMTP_HOST=smtp-mail.outlook.com, port 587,
# SMTP_USER/EMAIL_FROM = your full outlook.com address, SMTP_PASSWORD =
# an app password (account.live.com/proofs/AppPassword after enabling
# 2-step verification) — not your normal account password.
EMAIL_DRIVER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Allergenly <no-reply@allergenly.app>"

# --- Internal service-to-service auth -------------------------------------
# Shared secret required on the header `x-internal-secret` for any
# service-to-service call into /api/internal/*. Generate with:
# openssl rand -hex 32
INTERNAL_SERVICE_SECRET="replace-with-a-random-hex-secret"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
